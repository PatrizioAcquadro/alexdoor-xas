# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env
.env.*
!.env.example
.eggs/

# ── Tooling caches ───────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
/wandb/
/artifacts/

# ── Generated artifacts (see datasets/README.md, outputs/README.md) ──────────
# Datasets are tracked via their README.md; generated data stays local by default.
/datasets/*
!/datasets/README.md

# Raw run output stays local. Small, deliberately curated evidence can be
# committed under outputs/curated/.
/outputs/*
!/outputs/README.md
!/outputs/curated/
/outputs/curated/**
!/outputs/curated/**/
!/outputs/curated/**/*.md
!/outputs/curated/**/*.json
!/outputs/curated/**/*.csv
!/outputs/curated/**/*.png
!/outputs/curated/**/*.svg
!/outputs/curated/**/*.txt

# ── Large / machine-local sim artifacts ──────────────────────────────────────
*.log
*.hdf5
*.h5
*.mp4
*.pt
*.pth
*.ckpt
*.onnx
*.usdc            # binary USD caches; source scenes live outside this repo
*.occupancy.npz
*.topdown.png
.lmdb/

# ── Local phase records ──────────────────────────────────────────────────────
/implementation_phases/
/docs/

# ── Local assistant state ────────────────────────────────────────────────────
/.agents/
/.codex/
/.claude/
/CLAUDE.md
/claude.md
/AGENTS.md
/agents.md
/TODO.md
/prompts/

# ── Editor / OS cruft ────────────────────────────────────────────────────────
/knowledge/.obsidian/
.idea/
.vscode/
.DS_Store
